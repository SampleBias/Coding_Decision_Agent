{
  "version": 1,
  "threshold_default": 0.7,
  "families": [
    {
      "id": "code_review",
      "description": "Grade a code change (diff or snippet) against a task.",
      "questions": [
        {
          "id": "code_quality",
          "type": "score",
          "instructions": "Rate the overall quality of the proposed code or patch with respect to the task: correctness, readability, efficiency, style and how well it follows the instructions.",
          "options": [
            "0",
            "1",
            "2",
            "3",
            "4"
          ],
          "gloss": [
            "very poor",
            "poor",
            "acceptable",
            "good",
            "excellent"
          ]
        },
        {
          "id": "instruction_followed",
          "type": "choice",
          "instructions": "Does the proposed code or patch follow the task instructions and stated preferences?",
          "options": [
            "no",
            "yes"
          ],
          "gloss": [
            "no",
            "yes"
          ]
        },
        {
          "id": "likely_correct",
          "type": "choice",
          "instructions": "Judging from the task, the patch and any test output, is the change likely to fully resolve the task (tests would pass)?",
          "options": [
            "no",
            "yes"
          ],
          "gloss": [
            "no",
            "yes"
          ]
        },
        {
          "id": "merge_action",
          "type": "choice",
          "instructions": "What should a code reviewer do with this change?",
          "options": [
            "accept",
            "request_changes",
            "needs_tests",
            "reject"
          ],
          "gloss": [
            "accept",
            "request_changes",
            "needs_tests",
            "reject"
          ]
        }
      ]
    },
    {
      "id": "tool_call",
      "description": "Grade proposed tool call(s) against a request and the available tools.",
      "questions": [
        {
          "id": "tool_selection",
          "type": "score",
          "instructions": "Are the right tools selected for the request, with no missing or extraneous tools?",
          "options": [
            "0",
            "1",
            "2"
          ],
          "gloss": [
            "wrong",
            "partial",
            "correct"
          ]
        },
        {
          "id": "parameter_structure",
          "type": "score",
          "instructions": "Are the tool call arguments complete, correctly named and correctly structured?",
          "options": [
            "0",
            "1",
            "2"
          ],
          "gloss": [
            "wrong",
            "partial",
            "correct"
          ]
        },
        {
          "id": "sequence_accuracy",
          "type": "score",
          "instructions": "Are the tool calls ordered so that each call has the data it depends on?",
          "options": [
            "0",
            "1",
            "2"
          ],
          "gloss": [
            "wrong",
            "partial",
            "correct"
          ]
        },
        {
          "id": "query_coverage",
          "type": "score",
          "instructions": "Does the tool call plan address every part of the user's request?",
          "options": [
            "0",
            "1",
            "2"
          ],
          "gloss": [
            "wrong",
            "partial",
            "correct"
          ]
        },
        {
          "id": "should_call_tool",
          "type": "choice",
          "instructions": "Given the request and the available tools, what is the right thing for the assistant to do next?",
          "options": [
            "call_tool",
            "ask_followup",
            "answer_directly",
            "cannot_answer"
          ],
          "gloss": [
            "call_tool",
            "ask_followup",
            "answer_directly",
            "cannot_answer"
          ]
        },
        {
          "id": "call_verdict",
          "type": "choice",
          "instructions": "How should the agent runtime treat the proposed tool call(s)?",
          "options": [
            "execute",
            "fix_args",
            "wrong_tool",
            "abstain"
          ],
          "gloss": [
            "execute",
            "fix_args",
            "wrong_tool",
            "abstain"
          ]
        }
      ]
    },
    {
      "id": "agent_trace",
      "description": "Triage an agent execution trace (observability).",
      "questions": [
        {
          "id": "action",
          "type": "choice",
          "instructions": "What should the observability system do with this trace?",
          "options": [
            "continue",
            "observe",
            "human_review",
            "stop"
          ],
          "gloss": [
            "continue",
            "observe",
            "human_review",
            "stop"
          ]
        },
        {
          "id": "needs_review",
          "type": "choice",
          "instructions": "This trace requires human review.",
          "options": [
            "no",
            "yes"
          ],
          "gloss": [
            "no",
            "yes"
          ]
        },
        {
          "id": "outcome",
          "type": "choice",
          "instructions": "How did this agent run turn out?",
          "options": [
            "success",
            "partial",
            "failure",
            "harmful"
          ],
          "gloss": [
            "success",
            "partial",
            "failure",
            "harmful"
          ]
        },
        {
          "id": "risk",
          "type": "score",
          "instructions": "How risky was the agent's behaviour in this trace?",
          "options": [
            "0",
            "1",
            "2",
            "3"
          ],
          "gloss": [
            "Benign",
            "Low",
            "Moderate",
            "High"
          ]
        },
        {
          "id": "urgency",
          "type": "score",
          "instructions": "How quickly does this trace need attention?",
          "options": [
            "0",
            "1",
            "2",
            "3"
          ],
          "gloss": [
            "No time pressure; can wait indefinitely.",
            "Routine; handle within the normal queue.",
            "Elevated; should be handled within the same week.",
            "Critical; requires action within the same day."
          ]
        }
      ]
    },
    {
      "id": "routing",
      "description": "Route a request to a model tier and a skill.",
      "questions": [
        {
          "id": "model_tier",
          "type": "choice",
          "instructions": "Which is the cheapest model tier that can be expected to solve this request correctly?",
          "options": [
            "small_fast",
            "mid",
            "frontier",
            "reasoning"
          ],
          "gloss": [
            "small_fast",
            "mid",
            "frontier",
            "reasoning"
          ]
        },
        {
          "id": "task_difficulty",
          "type": "score",
          "instructions": "How difficult is this coding or agent request?",
          "options": [
            "0",
            "1",
            "2",
            "3"
          ],
          "gloss": [
            "trivial",
            "easy",
            "hard",
            "very hard"
          ]
        },
        {
          "id": "skill",
          "type": "choice",
          "instructions": "Which coding-agent skill best matches what this request needs first?",
          "options": [
            "code_edit",
            "debug",
            "write_tests",
            "refactor",
            "explain",
            "shell_ops",
            "research",
            "plan"
          ],
          "gloss": [
            "code_edit",
            "debug",
            "write_tests",
            "refactor",
            "explain",
            "shell_ops",
            "research",
            "plan"
          ]
        }
      ]
    }
  ],
