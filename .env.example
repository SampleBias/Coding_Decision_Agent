# Copy to .env (never commit .env). On RunPod, export these in the pod environment instead.

# Hugging Face WRITE token for the S4MPL3BI4S account (needed for publish steps).
HF_TOKEN=hf_xxx

# Destination repos on the Hub.
HF_MODEL_REPO=S4MPL3BI4S/Coding_Decision_Agent
HF_DATASET_REPO=S4MPL3BI4S/coding-decision-cases

# Base checkpoint to fine-tune from.
BASE_MODEL=convaiinnovations/laya

# Teacher (local vLLM). Served by runpod/serve_teacher.sh; teacher_vllm.py talks to it over HTTP.
TEACHER_MODEL=Qwen/Qwen3-32B-AWQ
TEACHER_BASE_URL=http://127.0.0.1:8000/v1

# Where everything is written on the pod.
WORKDIR=/workspace/coding_decision_agent

# Training profile: a100_80gb | gpu_24gb (see configs/train.yaml)
TRAIN_PROFILE=a100_80gb

# Optional experiment tracking.
WANDB_API_KEY=
WANDB_PROJECT=coding-decision-agent
